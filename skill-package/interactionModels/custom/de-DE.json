        },
        {
          "name": "VolumeDownIntent",
          "samples": [
            "leiser",
            "mach leiser",
            "verringere die lautstärke"
          ]
        }
      ],
      "types": [
        {
          "name": "ONOFF",
          "values": [
            { "name": { "value": "an", "synonyms": ["ein", "einschalten", "aktivieren"] } },
            { "name": { "value": "aus", "synonyms": ["ausschalten", "deaktivieren"] } }
          ]
