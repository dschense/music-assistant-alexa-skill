            "spiele das album {album}",
            "spiele {artist}",
            "spiele {playlist} playlist",
            "starte {playlist}"
          ]
        },
        {
          "name": "SearchIntent",
          "slots": [
            { "name": "song", "type": "SONG" },
            { "name": "artist", "type": "ARTIST" },
            { "name": "album", "type": "ALBUM" },
            { "name": "playlist", "type": "PLAYLIST" }
          ],
          "samples": [
            "suche nach {song}",
            "suche {artist}",
            "suche das album {album}",
            "suche die playlist {playlist}"
          ]
        },
        {
          "name": "PlayRadioIntent",
          "slots": [
            { "name": "seedArtist", "type": "ARTIST" }
